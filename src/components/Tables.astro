---
type Result = {
  competition: string;
  date: string;
  placement: string;
  placeOrder: number;
  featured?: boolean;
};

type Props = {
  results: Result[];
};

const { results } = Astro.props;
const rows = [...results].sort(
  (a, b) => a.placeOrder - b.placeOrder || b.date.localeCompare(a.date)
);

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const formatDate = (iso: string) => {
  const [, month, day] = iso.split("-");
  return `${months[Number(month) - 1]} ${Number(day)}, ${iso.slice(0, 4)}`;
};
---

<div class="table-wrap not-prose">
  <table class="evt-table">
    <caption class="sr-only">Selected CTF competition results</caption>
    <thead>
      <tr>
        <th scope="col" data-sort="event" aria-sort="none">
          <button type="button" class="th-inner" aria-label="Sort by event">
            Event<span class="sort-caret" aria-hidden="true"></span>
          </button>
        </th>
        <th scope="col" data-sort="date" aria-sort="none">
          <button type="button" class="th-inner" aria-label="Sort by date">
            Date<span class="sort-caret" aria-hidden="true"></span>
          </button>
        </th>
        <th scope="col" class="num is-active" data-sort="place" aria-sort="ascending">
          <button type="button" class="th-inner" aria-label="Sort by placement">
            Place<span class="sort-caret" aria-hidden="true"></span>
          </button>
        </th>
      </tr>
    </thead>
    <tbody>
      {rows.map(result => (
        <tr
          data-event={result.competition.toLocaleLowerCase()}
          data-date={result.date}
          data-place={result.placeOrder}
        >
          <th scope="row" class="evt-name">{result.competition}</th>
          <td class="evt-date" data-date-display={formatDate(result.date)}>{formatDate(result.date)}</td>
          <td class="num">
            <span class:list={[
              "place",
              result.featured ? "place--featured" : result.placement === "Qualified for finals" ? "place--muted" : "",
            ]}>
              {result.placement}
            </span>
          </td>
        </tr>
      ))}
      <tr class="show-all-row">
        <td colspan="3">
          <button type="button" class="show-all-btn">
            Show all ({rows.length} events)
          </button>
        </td>
      </tr>
    </tbody>
  </table>
</div>

<script>
  const initializeResultTables = () => {
    document.querySelectorAll<HTMLTableElement>(".evt-table:not([data-ready])").forEach(table => {
      table.dataset.ready = "true";
      const tbody = table.tBodies[0];
      if (!tbody) return;

      const headers = Array.from(table.querySelectorAll<HTMLTableCellElement>("th[data-sort]"));
      const showAllRow = tbody.querySelector<HTMLTableRowElement>(".show-all-row");
      const showAllButton = showAllRow?.querySelector<HTMLButtonElement>(".show-all-btn");
      let sortedBy: "event" | "date" | "place" = "place";
      let descending = false;
      let expanded = false;

      const getRows = () => Array.from(tbody.querySelectorAll<HTMLTableRowElement>("tr:not(.show-all-row)"));

      const updateVisibility = () => {
        const rows = getRows();
        rows.forEach((row, index) => row.classList.toggle("is-hidden", !expanded && index >= 7));
        if (showAllRow) {
          showAllRow.classList.toggle("is-hidden", rows.length <= 7 || expanded);
          tbody.append(showAllRow);
        }
      };

      headers.forEach(header => {
        header.querySelector("button")?.addEventListener("click", () => {
          const column = header.dataset.sort as typeof sortedBy | undefined;
          if (!column) return;

          if (sortedBy === column) descending = !descending;
          else {
            sortedBy = column;
          descending = column === "date";
          }

          headers.forEach(item => {
            const active = item === header;
            item.setAttribute("aria-sort", active ? (descending ? "descending" : "ascending") : "none");
            item.classList.toggle("is-active", active);
          });

          getRows()
            .sort((a, b) => {
              const valueA = a.dataset[column] ?? "";
              const valueB = b.dataset[column] ?? "";
              const order = column === "place"
                ? Number(valueA) - Number(valueB)
                : valueA.localeCompare(valueB, undefined, { numeric: true, sensitivity: "base" });
              return descending ? -order : order;
            })
            .forEach(row => tbody.insertBefore(row, showAllRow));

          updateVisibility();
        });
      });

      showAllButton?.addEventListener("click", () => {
        expanded = !expanded;
        showAllButton.textContent = expanded ? "Show fewer results" : `Show all (${getRows().length} events)`;
        updateVisibility();
      });

      headers.find(header => header.dataset.sort === sortedBy)?.classList.add("is-active");
      updateVisibility();
    });
  };

  initializeResultTables();
  document.addEventListener("astro:page-load", initializeResultTables);
</script>

<style>
  .table-wrap {
    margin: 1.5rem 0;
    overflow-x: auto;
    border-block: 1px solid var(--border);
  }

  .evt-table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
  }

  .evt-table th[scope="col"] {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    color: color-mix(in srgb, var(--foreground) 65%, var(--background));
    font-size: 0.8rem;
    font-weight: 500;
    user-select: none;
  }

  .th-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: inherit;
  }

  th[data-sort] { cursor: pointer; }
  th[data-sort]:hover,
  th.is-active { color: var(--accent); }
  .num .th-inner { justify-content: flex-end; }

  .sort-caret {
    opacity: 0;
    transition: opacity 0.16s ease;
  }
  .sort-caret::after { content: "↕"; }
  th:hover .sort-caret,
  th.is-active .sort-caret { opacity: 0.75; }
  th[aria-sort="ascending"] .sort-caret::after { content: "↑"; }
  th[aria-sort="descending"] .sort-caret::after { content: "↓"; }

  .evt-table tbody tr:not(.show-all-row) {
    border-bottom: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
    transition: background-color 0.15s ease;
  }
  .evt-table tbody tr:not(.show-all-row):hover { background: color-mix(in srgb, var(--muted) 16%, transparent); }
  .evt-table tbody tr.is-hidden,
  .show-all-row.is-hidden { display: none; }

  .evt-table td,
  .evt-table th[scope="row"] {
    padding: 0.68rem 1rem;
    font-size: 0.85rem;
  }
  .evt-name { color: var(--foreground); font-weight: 400; text-align: left; }
  .evt-date { color: color-mix(in srgb, var(--foreground) 70%, var(--background)); white-space: nowrap; }
  .num { text-align: right; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-variant-numeric: tabular-nums; }

  .place {
    color: color-mix(in srgb, var(--foreground) 80%, var(--background));
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .place--featured { color: var(--accent); font-weight: 600; }
  .place--muted { color: color-mix(in srgb, var(--foreground) 60%, var(--background)); }

  .show-all-row td { padding: 0; }
  .show-all-btn {
    width: 100%;
    padding: 0.7rem 1rem;
    border: 0;
    background: transparent;
    color: var(--accent);
    font-size: 0.85rem;
  }
  .show-all-btn:hover { text-decoration: underline; text-underline-offset: 0.2rem; }

  @media (max-width: 639px) {
    .evt-table { min-width: 31rem; }
  }
</style>
